# Slovenec — kopirajte v .env in prilagodite.
# Nikoli ne objavite .env v git.

APP_ENV=development
SECRET_KEY=change-me-to-a-long-random-string

# SQLite lokalno, Postgres v produkciji
# DATABASE_URL=sqlite:///server/slovenec.db
# DATABASE_URL=postgresql+psycopg://user:password@host:5432/slovenec

# Prvi skrbnik (ustvari se ob zagonu, če ne obstaja)
ADMIN_EMAIL=admin@slovenec.local
ADMIN_PASSWORD=slovenec123

# Javni naslov in CORS
PUBLIC_BASE_URL=http://127.0.0.1:8000
ALLOWED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

# Podatki portala
SITE_NAME=Slovenec
SITE_TAGLINE=Slovenske novice, brez šuma
SITE_EMAIL=urednistvo@slovenec.local
SITE_CITY=Ljubljana
